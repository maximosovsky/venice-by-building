# raw source data stays on disk, out of the repository
data/raw/
data/processed/
data/ready/
!data/raw/.gitkeep

# prepared enrichment sidecars: the deployment serves only web/data/enrichment-public/.
# The prepared originals stay on disk; tracking them makes the static host serve a second,
# unprojected copy and doubles the upload (see web/data/enrichment-public/manifest.json).
web/data/addresses.json
web/data/building-evidence.json
web/data/bridge-characteristics.json
web/data/history-registers.json
web/data/history-registers/

# a reference copy of the engine we vendor from (its sample data is 11 MB and not ours)
research/engines/sydmap-full/
# heavyweight read-only snapshots taken while auditing other engines
research/engines/city-sites-audit/
research/engines/city_engines/
research/engines/venice-repo-audit/
research/provenance/venice_probe/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# build output and local tools
node_modules/
dist/
.vite/
